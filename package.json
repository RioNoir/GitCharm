{
  "name": "gitcharm",
  "displayName": "GitCharm",
  "description": "%extension.description%",
  "version": "0.4.9",
  "publisher": "RioNoir",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/RioNoir/GitCharm.git"
  },
  "sponsor": {
    "url": "https://ko-fi.com/rionoir"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "scm",
    "commit",
    "log",
    "merge",
    "intellij",
    "phpstorm",
    "jetbrains",
    "pull request",
    "stash",
    "shelve",
    "changelist",
    "worktree",
    "submodule",
    "annotations",
    "ghost text"
  ],
  "icon": "media/icons/gitcharm.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "activationEvents": [
    "workspaceContains:**/.git",
    "onStartupFinished",
    "onView:gitcharm.commitPanel",
    "onView:gitcharm.gitLog",
    "onCommand:gitcharm.openLog",
    "onWebviewPanel:gitcharm.undocked",
    "onWebviewPanel:gitcharm.commitFullDetail",
    "onWebviewPanel:gitcharm.pullRequestDetail"
  ],
  "main": "./out/host/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "submenus": [
      {
        "id": "gitcharm/explorer",
        "label": "GitCharm"
      },
      {
        "id": "gitcharm/commitPanel.fileView",
        "label": "%submenu.commitPanel.fileView.label%"
      },
      {
        "id": "gitcharm/commitPanel.sortRepos",
        "label": "%submenu.commitPanel.sortRepos.label%"
      },
      {
        "id": "gitcharm/commitPanel.reposWithoutChanges",
        "label": "%submenu.commitPanel.reposWithoutChanges.label%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitcharm-commit",
          "title": "GitCharm",
          "icon": "media/icons/git-commit.svg"
        }
      ],
      "panel": [
        {
          "id": "gitcharm-log",
          "title": "%viewsContainer.gitcharm-log.title%",
          "icon": "media/icons/git-merge.svg"
        }
      ]
    },
    "views": {
      "gitcharm-commit": [
        {
          "type": "webview",
          "id": "gitcharm.commitPanel",
          "name": "GitCharm",
          "retainContextWhenHidden": true
        },
        {
          "id": "gitcharm.commitBadge",
          "name": "",
          "when": "false"
        }
      ],
      "gitcharm-log": [
        {
          "type": "webview",
          "id": "gitcharm.gitLog",
          "name": "%view.gitLog.name%",
          "retainContextWhenHidden": true,
          "when": "!gitcharm.gitLogDefaultUndocked"
        }
      ]
    },
    "commands": [
      {
        "command": "gitcharm.openLog",
        "title": "%command.openLog.title%",
        "category": "GitCharm",
        "icon": "$(history)"
      },
      {
        "command": "gitcharm.showOutputLog",
        "title": "%command.showOutputLog.title%",
        "category": "GitCharm"
      },
      {
        "command": "gitcharm.commit",
        "title": "%command.commit.title%",
        "category": "GitCharm"
      },
      {
        "command": "gitcharm.commitAndPush",
        "title": "%command.commitAndPush.title%",
        "category": "GitCharm"
      },
      {
        "command": "gitcharm.pull",
        "title": "%command.pull.title%",
        "category": "GitCharm"
      },
      {
        "command": "gitcharm.push",
        "title": "%command.push.title%",
        "category": "GitCharm",
        "icon": "$(repo-push)"
      },
      {
        "command": "gitcharm.fetchAll",
        "title": "%command.fetchAll.title%",
        "category": "GitCharm",
        "icon": "$(repo-fetch)"
      },
      {
        "command": "gitcharm.checkOrphanBranches",
        "title": "%command.checkOrphanBranches.title%",
        "category": "GitCharm",
        "icon": "$(cloud-offline)"
      },
      {
        "command": "gitcharm.syncAll",
        "title": "%command.syncAll.title%",
        "category": "GitCharm",
        "icon": "$(sync)"
      },
      {
        "command": "gitcharm.openMergeEditor",
        "title": "%command.openMergeEditor.title%",
        "category": "GitCharm"
      },
      {
        "command": "gitcharm.refreshCommitPanel",
        "title": "%command.refreshCommitPanel.title%",
        "category": "GitCharm",
        "icon": "$(refresh)"
      },
      {
        "command": "gitcharm.setFileViewFlat",
        "title": "%command.setFileViewFlat.title%",
        "category": "GitCharm"
      },
      {
        "command": "gitcharm.setFileViewFlatChecked",
        "title": "%command.setFileViewFlatChecked.title%",
        "category": "GitCharm"
      },
      {
        "command": "gitcharm.setFileViewTree",
        "title": "%command.setFileViewTree.title%",
        "category": "GitCharm"
      },
      {
        "command": "gitcharm.setFileViewTreeChecked",
        "title": "%command.setFileViewTreeChecked.title%",
        "category": "GitCharm"
      },
      {
        "command": "gitcharm.sortReposByDiscovery",
        "title": "%command.sortReposByDiscovery.title%",
        "category": "GitCharm"
      },
      {
        "command": "gitcharm.sortReposByDiscoveryChecked",
        "title": "%command.sortReposByDiscoveryChecked.title%",
        "category": "GitCharm"
      },
      {
        "command": "gitcharm.sortReposByName",
        "title": "%command.sortReposByName.title%",
        "category": "GitCharm"
      },
      {
        "command": "gitcharm.sortReposByNameChecked",
        "title": "%command.sortReposByNameChecked.title%",
        "category": "GitCharm"
      },
      {
        "command": "gitcharm.sortReposByPath",
        "title": "%command.sortReposByPath.title%",
        "category": "GitCharm"
      },
      {
        "command": "gitcharm.sortReposByPathChecked",
        "title": "%command.sortReposByPathChecked.title%",
        "category": "GitCharm"
      },
      {
        "command": "gitcharm.showReposWithoutChanges",
        "title": "%command.showReposWithoutChanges.title%",
        "category": "GitCharm"
      },
      {
        "command": "gitcharm.showReposWithoutChangesChecked",
        "title": "%command.showReposWithoutChangesChecked.title%",
        "category": "GitCharm"
      },
      {
        "command": "gitcharm.hideReposWithoutChanges",
        "title": "%command.hideReposWithoutChanges.title%",
        "category": "GitCharm"
      },
      {
        "command": "gitcharm.hideReposWithoutChangesChecked",
        "title": "%command.hideReposWithoutChangesChecked.title%",
        "category": "GitCharm"
      },
      {
        "command": "gitcharm.showBranchMenu",
        "title": "%command.showBranchMenu.title%",
        "category": "GitCharm",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitcharm.updateProject",
        "title": "%command.updateProject.title%",
        "category": "GitCharm",
        "icon": "$(repo-pull)"
      },
      {
        "command": "gitcharm.openSettings",
        "title": "%command.openSettings.title%",
        "category": "GitCharm",
        "icon": "$(settings-gear)"
      },
      {
        "command": "gitcharm.resetViewLocations",
        "title": "%command.resetViewLocations.title%",
        "category": "GitCharm",
        "icon": "$(discard)"
      },
      {
        "command": "gitcharm.openGitAnnotations",
        "title": "%command.openGitAnnotations.title%",
        "category": "GitCharm",
        "icon": "$(git-commit)"
      },
      {
        "command": "gitcharm.closeGitAnnotations",
        "title": "%command.closeGitAnnotations.title%",
        "category": "GitCharm",
        "icon": "$(git-commit)"
      },
      {
        "command": "gitcharm.toggleGitAnnotations",
        "title": "%command.toggleGitAnnotations.title%",
        "category": "GitCharm",
        "icon": "$(git-commit)"
      },
      {
        "command": "gitcharm.navigateToAnnotationCommit",
        "title": "%command.navigateToAnnotationCommit.title%",
        "category": "GitCharm"
      },
      {
        "command": "gitcharm.manageHiddenRepos",
        "title": "%command.manageHiddenRepos.title%",
        "category": "GitCharm",
        "icon": "$(eye-closed)"
      },
      {
        "command": "gitcharm.manageProfiles",
        "title": "%command.manageProfiles.title%",
        "category": "GitCharm",
        "icon": "$(account)"
      },
      {
        "command": "gitcharm.switchProfile",
        "title": "%command.switchProfile.title%",
        "category": "GitCharm",
        "icon": "$(account)"
      },
      {
        "command": "gitcharm.submodule.init",
        "title": "%command.submodule.init.title%",
        "category": "GitCharm"
      },
      {
        "command": "gitcharm.submodule.update",
        "title": "%command.submodule.update.title%",
        "category": "GitCharm"
      },
      {
        "command": "gitcharm.submodule.updateRecursive",
        "title": "%command.submodule.updateRecursive.title%",
        "category": "GitCharm"
      },
      {
        "command": "gitcharm.submodule.deinit",
        "title": "%command.submodule.deinit.title%",
        "category": "GitCharm"
      },
      {
        "command": "gitcharm.submodule.deinitForce",
        "title": "%command.submodule.deinitForce.title%",
        "category": "GitCharm"
      },
      {
        "command": "gitcharm.submodule.openInNewWindow",
        "title": "%command.submodule.openInNewWindow.title%",
        "category": "GitCharm"
      },
      {
        "command": "gitcharm.worktree.add",
        "title": "%command.worktree.add.title%",
        "category": "GitCharm"
      },
      {
        "command": "gitcharm.worktree.prune",
        "title": "%command.worktree.prune.title%",
        "category": "GitCharm"
      },
      {
        "command": "gitcharm.pullRequests.manageCredentials",
        "title": "%command.pullRequests.manageCredentials.title%",
        "category": "GitCharm"
      },
      {
        "command": "gitcharm.pullRequests.refresh",
        "title": "%command.pullRequests.refresh.title%",
        "category": "GitCharm"
      },
      {
        "command": "gitcharm.selectAiModel",
        "title": "%command.selectAiModel.title%",
        "category": "GitCharm"
      },
      {
        "command": "gitcharm.showBranchOptions",
        "title": "%command.showBranchOptions.title%",
        "category": "GitCharm"
      },
      {
        "command": "gitcharm.undock",
        "title": "%command.undock.title%",
        "category": "GitCharm",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "gitcharm.setGitLogDefaultLocation",
        "title": "%command.setGitLogDefaultLocation.title%",
        "category": "GitCharm",
        "icon": "$(settings-gear)"
      },
      {
        "command": "gitcharm.showFileHistory",
        "title": "%command.showFileHistory.title%",
        "category": "GitCharm",
        "icon": "$(history)"
      },
      {
        "command": "gitcharm.compareWith",
        "title": "%command.compareWith.title%",
        "category": "GitCharm",
        "icon": "$(git-compare)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitcharm.fetchAll",
          "when": "view == gitcharm.commitPanel",
          "group": "navigation@1"
        },
        {
          "command": "gitcharm.updateProject",
          "when": "view == gitcharm.commitPanel",
          "group": "navigation@2"
        },
        {
          "command": "gitcharm.push",
          "when": "view == gitcharm.commitPanel",
          "group": "navigation@3"
        },
        {
          "command": "gitcharm.syncAll",
          "when": "view == gitcharm.commitPanel",
          "group": "navigation@4"
        },
        {
          "command": "gitcharm.showBranchMenu",
          "when": "view == gitcharm.commitPanel",
          "group": "navigation@5"
        },
        {
          "command": "gitcharm.openLog",
          "when": "view == gitcharm.commitPanel",
          "group": "navigation@6"
        },
        {
          "command": "gitcharm.refreshCommitPanel",
          "when": "view == gitcharm.commitPanel",
          "group": "1_viewSort@1"
        },
        {
          "command": "gitcharm.openSettings",
          "when": "view == gitcharm.commitPanel",
          "group": "1_viewSort@2"
        },
        {
          "submenu": "gitcharm/commitPanel.fileView",
          "when": "view == gitcharm.commitPanel",
          "group": "2_viewSort@1"
        },
        {
          "submenu": "gitcharm/commitPanel.sortRepos",
          "when": "view == gitcharm.commitPanel",
          "group": "2_viewSort@2"
        },
        {
          "submenu": "gitcharm/commitPanel.reposWithoutChanges",
          "when": "view == gitcharm.commitPanel",
          "group": "2_viewSort@3"
        },
        {
          "command": "gitcharm.manageHiddenRepos",
          "when": "view == gitcharm.commitPanel",
          "group": "2_viewSort@4"
        }
      ],
      "gitcharm/commitPanel.fileView": [
        {
          "command": "gitcharm.setFileViewFlat",
          "when": "gitcharm.fileViewMode != 'flat'",
          "group": "navigation@1"
        },
        {
          "command": "gitcharm.setFileViewFlatChecked",
          "when": "gitcharm.fileViewMode == 'flat'",
          "group": "navigation@1"
        },
        {
          "command": "gitcharm.setFileViewTree",
          "when": "gitcharm.fileViewMode != 'tree'",
          "group": "navigation@2"
        },
        {
          "command": "gitcharm.setFileViewTreeChecked",
          "when": "gitcharm.fileViewMode == 'tree'",
          "group": "navigation@2"
        }
      ],
      "gitcharm/commitPanel.sortRepos": [
        {
          "command": "gitcharm.sortReposByDiscovery",
          "when": "gitcharm.repoSortMode != 'discovery'",
          "group": "navigation@1"
        },
        {
          "command": "gitcharm.sortReposByDiscoveryChecked",
          "when": "gitcharm.repoSortMode == 'discovery'",
          "group": "navigation@1"
        },
        {
          "command": "gitcharm.sortReposByName",
          "when": "gitcharm.repoSortMode != 'name'",
          "group": "navigation@2"
        },
        {
          "command": "gitcharm.sortReposByNameChecked",
          "when": "gitcharm.repoSortMode == 'name'",
          "group": "navigation@2"
        },
        {
          "command": "gitcharm.sortReposByPath",
          "when": "gitcharm.repoSortMode != 'path'",
          "group": "navigation@3"
        },
        {
          "command": "gitcharm.sortReposByPathChecked",
          "when": "gitcharm.repoSortMode == 'path'",
          "group": "navigation@3"
        }
      ],
      "gitcharm/commitPanel.reposWithoutChanges": [
        {
          "command": "gitcharm.showReposWithoutChanges",
          "when": "gitcharm.hideReposWithoutChanges",
          "group": "navigation@1"
        },
        {
          "command": "gitcharm.showReposWithoutChangesChecked",
          "when": "!gitcharm.hideReposWithoutChanges",
          "group": "navigation@1"
        },
        {
          "command": "gitcharm.hideReposWithoutChanges",
          "when": "!gitcharm.hideReposWithoutChanges",
          "group": "navigation@2"
        },
        {
          "command": "gitcharm.hideReposWithoutChangesChecked",
          "when": "gitcharm.hideReposWithoutChanges",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "gitcharm.fetchAll",
          "when": "activeWebviewPanelId == gitcharm.undocked",
          "group": "navigation@1"
        },
        {
          "command": "gitcharm.updateProject",
          "when": "activeWebviewPanelId == gitcharm.undocked",
          "group": "navigation@2"
        },
        {
          "command": "gitcharm.push",
          "when": "activeWebviewPanelId == gitcharm.undocked",
          "group": "navigation@3"
        },
        {
          "command": "gitcharm.syncAll",
          "when": "activeWebviewPanelId == gitcharm.undocked",
          "group": "navigation@4"
        },
        {
          "command": "gitcharm.showBranchMenu",
          "when": "activeWebviewPanelId == gitcharm.undocked",
          "group": "navigation@5"
        },
        {
          "command": "gitcharm.openSettings",
          "when": "activeWebviewPanelId == gitcharm.undocked",
          "group": "navigation@6"
        }
      ],
      "scm/sourceControl": [
        {
          "command": "gitcharm.manageHiddenRepos",
          "group": "gitcharm@1"
        }
      ],
      "commandPalette": [
        {
          "command": "gitcharm.openLog"
        },
        {
          "command": "gitcharm.showBranchMenu"
        },
        {
          "command": "gitcharm.commit"
        },
        {
          "command": "gitcharm.fetchAll"
        },
        {
          "command": "gitcharm.checkOrphanBranches"
        },
        {
          "command": "gitcharm.updateProject"
        },
        {
          "command": "gitcharm.push"
        },
        {
          "command": "gitcharm.syncAll"
        },
        {
          "command": "gitcharm.refreshCommitPanel"
        },
        {
          "command": "gitcharm.setFileViewFlat",
          "when": "false"
        },
        {
          "command": "gitcharm.setFileViewFlatChecked",
          "when": "false"
        },
        {
          "command": "gitcharm.setFileViewTree",
          "when": "false"
        },
        {
          "command": "gitcharm.setFileViewTreeChecked",
          "when": "false"
        },
        {
          "command": "gitcharm.sortReposByDiscovery",
          "when": "false"
        },
        {
          "command": "gitcharm.sortReposByDiscoveryChecked",
          "when": "false"
        },
        {
          "command": "gitcharm.sortReposByName",
          "when": "false"
        },
        {
          "command": "gitcharm.sortReposByNameChecked",
          "when": "false"
        },
        {
          "command": "gitcharm.sortReposByPath",
          "when": "false"
        },
        {
          "command": "gitcharm.sortReposByPathChecked",
          "when": "false"
        },
        {
          "command": "gitcharm.showReposWithoutChanges",
          "when": "false"
        },
        {
          "command": "gitcharm.showReposWithoutChangesChecked",
          "when": "false"
        },
        {
          "command": "gitcharm.hideReposWithoutChanges",
          "when": "false"
        },
        {
          "command": "gitcharm.hideReposWithoutChangesChecked",
          "when": "false"
        },
        {
          "command": "gitcharm.openMergeEditor"
        },
        {
          "command": "gitcharm.manageHiddenRepos"
        },
        {
          "command": "gitcharm.manageProfiles"
        },
        {
          "command": "gitcharm.switchProfile"
        },
        {
          "command": "gitcharm.selectAiModel"
        },
        {
          "command": "gitcharm.undock"
        },
        {
          "command": "gitcharm.setGitLogDefaultLocation"
        },
        {
          "command": "gitcharm.submodule.init"
        },
        {
          "command": "gitcharm.submodule.update"
        },
        {
          "command": "gitcharm.submodule.updateRecursive"
        },
        {
          "command": "gitcharm.submodule.deinit"
        },
        {
          "command": "gitcharm.submodule.deinitForce"
        },
        {
          "command": "gitcharm.submodule.openInNewWindow"
        },
        {
          "command": "gitcharm.worktree.add"
        },
        {
          "command": "gitcharm.worktree.prune"
        },
        {
          "command": "gitcharm.openGitAnnotations",
          "when": "resourceScheme == file && config.gitcharm.gitAnnotations.enabled"
        },
        {
          "command": "gitcharm.closeGitAnnotations",
          "when": "resourceScheme == file && gitcharm.annotationsVisible"
        },
        {
          "command": "gitcharm.navigateToAnnotationCommit",
          "when": "false"
        },
        {
          "command": "gitcharm.showFileHistory",
          "when": "resourceScheme == file"
        },
        {
          "command": "gitcharm.compareWith",
          "when": "resourceScheme == file"
        },
        {
          "command": "gitcharm.commitAndPush",
          "when": "false"
        },
        {
          "command": "gitcharm.pull",
          "when": "false"
        },
        {
          "command": "gitcharm.openSettings",
          "when": "false"
        },
        {
          "command": "gitcharm.showBranchOptions",
          "when": "false"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "gitcharm.openGitAnnotations",
          "when": "resourceScheme == file && config.gitcharm.gitAnnotations.enabled && !gitcharm.annotationsVisible",
          "group": "gitcharm@1"
        },
        {
          "command": "gitcharm.closeGitAnnotations",
          "when": "resourceScheme == file && gitcharm.annotationsVisible",
          "group": "gitcharm@1"
        }
      ],
      "explorer/context": [
        {
          "submenu": "gitcharm/explorer",
          "when": "resourceScheme == file",
          "group": "gitcharm@1"
        }
      ],
      "gitcharm/explorer": [
        {
          "command": "gitcharm.showFileHistory",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "navigation@1"
        },
        {
          "command": "gitcharm.compareWith",
          "when": "resourceScheme == file",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "gitcharm.showFileHistory",
          "when": "resourceScheme == file",
          "group": "gitcharm@1"
        },
        {
          "command": "gitcharm.compareWith",
          "when": "resourceScheme == file",
          "group": "gitcharm@1"
        },
        {
          "command": "gitcharm.openMergeEditor",
          "when": "resourceScheme == file",
          "group": "gitcharm@2"
        },
        {
          "command": "gitcharm.openGitAnnotations",
          "when": "resourceScheme == file && config.gitcharm.gitAnnotations.enabled && !gitcharm.annotationsVisible",
          "group": "gitcharm@3"
        },
        {
          "command": "gitcharm.closeGitAnnotations",
          "when": "resourceScheme == file && gitcharm.annotationsVisible",
          "group": "gitcharm@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "gitcharm.openLog",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l"
      },
      {
        "command": "gitcharm.commit",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k"
      }
    ],
    "colors": [
      {
        "id": "gitcharm.statusBarPullForeground",
        "description": "%color.statusBarPullForeground.description%",
        "defaults": {
          "dark": "#64b5f6",
          "light": "#1565c0",
          "highContrast": "#64b5f6",
          "highContrastLight": "#1565c0"
        }
      },
      {
        "id": "gitcharm.statusBarPushForeground",
        "description": "%color.statusBarPushForeground.description%",
        "defaults": {
          "dark": "#ce93d8",
          "light": "#6a1b9a",
          "highContrast": "#ce93d8",
