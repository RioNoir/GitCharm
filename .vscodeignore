.vscode/**
.vscode-test/**
.idea/**
src/**
node_modules/**
.gitignore
eslint.config.mjs
tsconfig*.json
*.tsbuildinfo
esbuild.mjs
build-webview.mjs
test-build.mjs
vite.config.ts
MEMORY.md
.claude/**
.github/**
.ai/**
scripts/**
*.vsix
dist/**

# The host is a single esbuild bundle: drop any leftover tsc output (per-file .js/.d.ts/.map)
out/host/**
!out/host/extension.js

# Source maps and TypeScript sources/declarations — must stay after any "!" re-include,
# since the last matching pattern wins
**/*.map
**/*.ts
**/*.tsx

# README/CHANGELOG images: vsce rewrites relative links to GitHub URLs, so they aren't needed in the package
media/screenshots/**
media/banners/*.png
